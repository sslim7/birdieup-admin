# 이 파일을 .env 로 복사한 뒤 값을 채워서 사용하세요. (.env 는 git에 커밋하지 않습니다)
#   cp .env.example .env
#
# Vite 특성상 VITE_ 접두사가 붙은 변수만 앱 코드(import.meta.env)에서 접근 가능하며,
# 모든 값은 "빌드 시점"에 번들에 새겨집니다. 런타임 주입이 아니므로
# 스테이징/운영은 CI(도커 빌드)에서 --build-arg 로 환경별 값을 주입해 빌드합니다.

# ===== API =====
# 백엔드(birdieup-was) API 베이스 URL. 경로 접두사 없이 호스트까지만 넣는다
# (엔드포인트가 /admin/posts 처럼 루트에서 시작한다).
# - 로컬:   http://localhost:8081   ← birdieup-was 의 .env PORT=8081 과 같아야 한다
# - 운영:   https://api.birdieup.kr
VITE_API_BASE_URL=http://localhost:8081

# ===== 개발 서버 =====
# Vite 개발 서버 포트 (npm run dev 시 열리는 포트, vite.config.js 에서 읽습니다)
# birdieup-was 의 CORS_ALLOWED_ORIGINS 에 이 주소가 들어 있어야 한다
# (WAS .env 기본값: http://localhost:3001 — 앱 웹은 3003, WAS 는 8081).
# VITE_ 접두사가 없어 앱 번들에는 포함되지 않습니다.
PORT=3001
